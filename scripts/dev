#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
export PYTHONDONTWRITEBYTECODE=1
runtime/core-venv/bin/python - <<'PY'
from pathlib import Path
import secrets, os
folder=Path('runtime/data/security')
folder.mkdir(parents=True,exist_ok=True)
folder.chmod(0o700)
path=folder/'owner-token'
if not path.exists():
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(fd,'w') as stream:
        stream.write(secrets.token_urlsafe(32))
path.chmod(0o600)
PY
MNEMOS_OWNER_TOKEN="$(cat runtime/data/security/owner-token)"
export MNEMOS_OWNER_TOKEN
exec runtime/core-venv/bin/uvicorn mnemos.api:create_app --factory --host 127.0.0.1 --port 8000
