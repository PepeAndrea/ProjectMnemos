{
  "$defs": {
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "method": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "method"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "title": "Conversation Id",
      "type": "string"
    },
    "speaker_session_id": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Speaker Session Id",
      "type": "string"
    },
    "speaker_entity_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speaker Entity Id"
    },
    "speaker_confidence": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Speaker Confidence",
      "type": "number"
    },
    "text": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "language": {
      "enum": [
        "it",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "start_seconds": {
      "minimum": 0,
      "title": "Start Seconds",
      "type": "number"
    },
    "end_seconds": {
      "minimum": 0,
      "title": "End Seconds",
      "type": "number"
    },
    "final": {
      "default": false,
      "title": "Final",
      "type": "boolean"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "source_audio_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Audio Id"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "conversation_id",
    "speaker_session_id",
    "text",
    "language",
    "start_seconds",
    "end_seconds",
    "confidence",
    "provenance"
  ],
  "title": "Utterance",
  "type": "object"
}
